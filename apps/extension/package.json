{
  "name": "cts-git-graph",
  "displayName": "Git Graph - CTS",
  "description": "High-performance interactive Git graph, blame, rebase, worktrees, and remote operations for VS Code",
  "version": "1.0.0",
  "publisher": "CTS",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaoanhhaa1/git-graph.git"
  },
  "bugs": {
    "url": "https://github.com/thaoanhhaa1/git-graph/issues"
  },
  "homepage": "https://github.com/thaoanhhaa1/git-graph#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "git-graph",
    "graph",
    "visualization",
    "history",
    "branches",
    "commits",
    "tags",
    "diff",
    "blame",
    "rebase",
    "worktree",
    "submodule"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onCommand:gitGraph.toggleBlame",
    "onCommand:gitGraph.viewLineHistory"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gitGraph.openGraph",
        "title": "View Git Graph",
        "category": "Git Graph",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitGraph.viewFileHistory",
        "title": "View History in Git Graph",
        "category": "Git Graph",
        "icon": "$(history)"
      },
      {
        "command": "gitGraph.openFileAtRevision",
        "title": "Open File at Revision",
        "category": "Git Graph"
      },
      {
        "command": "gitGraph.fetch",
        "title": "Fetch from Remote",
        "category": "Git Graph",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraph.pull",
        "title": "Pull",
        "category": "Git Graph",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitGraph.push",
        "title": "Push",
        "category": "Git Graph",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitGraph.manageRemotes",
        "title": "Manage Remotes",
        "category": "Git Graph",
        "icon": "$(remote)"
      },
      {
        "command": "gitGraph.manageWorktrees",
        "title": "Manage Worktrees",
        "category": "Git Graph",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitGraph.toggleBlame",
        "title": "Toggle Git Blame Annotations",
        "category": "Git Graph"
      },
      {
        "command": "gitGraph.viewLineHistory",
        "title": "View Line History",
        "category": "Git Graph",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitGraph.openGraph"
        },
        {
          "command": "gitGraph.viewFileHistory"
        },
        {
          "command": "gitGraph.openFileAtRevision"
        },
        {
          "command": "gitGraph.fetch"
        },
        {
          "command": "gitGraph.pull"
        },
        {
          "command": "gitGraph.push"
        },
        {
          "command": "gitGraph.manageRemotes"
        },
        {
          "command": "gitGraph.manageWorktrees"
        },
        {
          "command": "gitGraph.toggleBlame"
        },
        {
          "command": "gitGraph.viewLineHistory"
        }
      ],
      "scm/title": [
        {
          "command": "gitGraph.openGraph",
          "group": "navigation@1",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "gitGraph.viewFileHistory",
          "group": "7_modification@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitGraph.viewFileHistory",
          "group": "navigation"
        },
        {
          "command": "gitGraph.viewLineHistory",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "gitGraph.viewLineHistory",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Graph",
      "properties": {
        "gitGraph.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item to open Git Graph."
        },
        "gitGraph.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Default number of commits to request per graph page."
        },
        "gitGraph.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Show the author column in the graph."
        },
        "gitGraph.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Show the date column in the graph."
        },
        "gitGraph.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show remote branch references in the graph."
        },
        "gitGraph.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show tag references in the graph."
        },
        "gitGraph.showMinimap": {
          "type": "boolean",
          "default": true,
          "description": "Show the vertical graph minimap overview next to the commit list."
        },
        "gitGraph.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Use compact 18px rows in the commit graph."
        },
        "gitGraph.blame.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show inline Git blame annotations after each line in the active editor."
        },
        "gitGraph.blame.format": {
          "type": "string",
          "default": "${author}, ${relativeDate} • ${subject}",
          "description": "Inline blame annotation format. Placeholders: ${author}, ${relativeDate}, ${subject}, ${shortSha}, ${sha}."
        },
        "gitGraph.dateType": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "default": "relative",
          "description": "Default date format for commits in the graph."
        },
        "gitGraph.commitOrdering": {
          "type": "string",
          "enum": [
            "date-order",
            "topo-order",
            "author-date-order"
          ],
          "enumDescriptions": [
            "Display commits in commit timestamp order (--date-order).",
            "Avoid interleaving commits from different branches (--topo-order).",
            "Display commits ordered by author date (--author-date-order)."
          ],
          "default": "date-order",
          "description": "Commit ordering strategy used in Git log."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-extension.mjs",
    "watch": "tsc -watch -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "package": "npx @vscode/vsce package --no-dependencies --out ../../dist/"
  },
  "dependencies": {
    "@git-graph/git-core": "*",
    "@git-graph/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
