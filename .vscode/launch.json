{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/extension"],
      "outFiles": ["${workspaceFolder}/apps/extension/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
