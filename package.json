{
  "name": "git-graph-monorepo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Git Graph VS Code Extension monorepo",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/thaoanhhaa1/git-graph.git"
  },
  "bugs": {
    "url": "https://github.com/thaoanhhaa1/git-graph/issues"
  },
  "homepage": "https://github.com/thaoanhhaa1/git-graph#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run --workspaces --if-present build && node scripts/bundle-extension.mjs",
    "watch": "npm run --workspaces --parallel --if-present watch",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --dir test/integration",
    "test:e2e": "npm run --workspace=apps/extension --if-present test:e2e",
    "package": "npm run build && npm run prepare:vsix && npm run --workspace=apps/extension package",
    "prepare:vsix": "node scripts/prepare-vsix.mjs",
    "republish": "npm run build && npm run typecheck && npm run lint && npm run format:fix && npm run test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:quick": "npm run build && node scripts/benchmark.mjs --quick --repeat=1 --output=docs/benchmark-report.quick.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
